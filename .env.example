# SetSignal Environment Configuration

# Google Gemini API Key (Required for Google ADK & Gemini)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Parallel Search API Key (Required for live external web grounding)
# Get your key at: https://platform.parallel.ai/
PARALLEL_API_KEY=your_parallel_api_key_here

# Gemini Model Configuration (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Server Port (Default: 8080)
PORT=8080
